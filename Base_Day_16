#include <iostream>
using namespace std;

long long factorial(int n) {
    // Base case: 0! and 1! are both 1.
    if (n == 0 || n == 1) {
        return 1;
    }

   
    return n * factorial(n - 1);
}

int main() {
    int n;
    cin >> n;

    
    if (n < 0) {
        cout << "Factorial is not defined for negative numbers." << endl;
    } else {
        cout << factorial(n) << endl;
    }

    return 0;
}

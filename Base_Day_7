Problem Statement & What to Create
Write a program to generate and print the first N terms of the Fibonacci sequence iteratively. The series starts with 0 and 1, and each subsequent term is the sum of the previous two terms.

#include <iostream>
using namespace std;

int main() {
    int N;
    cin >> N;

    int a = 0, b = 1;

    for (int i = 1; i <= N; i++) {
        cout << a << " ";

        int next = a + b;
        a = b;
        b = next;
    }

    return 0;
}

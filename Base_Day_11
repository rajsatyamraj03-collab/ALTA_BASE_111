#include <iostream>
using namespace std;

int main() {
    double A, B;
    char op;

    cin >> A >> B >> op;

    switch (op) {
        case '+':
            cout << A << " + " << B << " = " << A + B;
            break;

        case '-':
            cout << A << " - " << B << " = " << A - B;
            break;

        case '*':
            cout << A << " * " << B << " = " << A * B;
            break;

        case '/':
            if (B == 0) {
                cout << "Division by zero is not allowed";
            } else {
                cout << A << " / " << B << " = " << A / B;
            }
            break;

        case '%':
            if (B == 0) {
                cout << "Division by zero is not allowed";
            } else {
                cout << (int)A << " % " << (int)B << " = "
                     << (int)A % (int)B;
            }
            break;

        default:
            cout << "Invalid operator";
    }

    return 0;
}

Problem Statement & What to Create
Write a program to determine whether a given integer N (N > 1) is a prime number or not. Optimize the loop to check divisibility only up to sqrt(N).


#include <iostream>
using namespace std;

int main() {
    int N;
    cin >> N;

    bool isPrime = true;

    for (int i = 2; i * i <= N; i++) {
        if (N % i == 0) {
            isPrime = false;
            break;
        }
    }

    if (isPrime) {
        cout << N << " is a Prime Number";
    } else {
        cout << N << " is not a Prime Number";
    }

    return 0;
}

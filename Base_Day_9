

#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int arr[n];

    // Read array elements
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    // Assume the first element is the largest
    int largest = arr[0];

    // Find the largest element
    for (int i = 1; i < n; i++) {
        if (arr[i] > largest) {
            largest = arr[i];
        }
    }

    // Print the largest element
    cout << largest;

    return 0;
}


Example Input
5
10 25 7 42 18


Output
42

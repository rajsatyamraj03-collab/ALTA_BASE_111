#include <iostream>
using namespace std;

void printNumbers(int current, int n) {
 
    if (current > n) {
        return;
    }

    cout << current;

 
    if (current < n) {
        cout << " ";
    }

 
    printNumbers(current + 1, n);
}

int main() {
    int n;
    cin >> n;

  
    if (n <= 0) {
        return 0;
    }

  
    printNumbers(1, n);

    cout << endl;

    return 0;
}
